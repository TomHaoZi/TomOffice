{
  "name": "tom-office",
  "productName": "Tom Office",
  "private": true,
  "version": "0.3.0",
  "description": "Tom Office 桌面办公套件",
  "author": "Tom",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "pack": "npm run build && electron-builder --win --dir --x64",
    "test": "node --test tests/*.test.js",
    "test:desktop": "npm run build && node tests/desktop-smoke.mjs && node tests/desktop-enhanced.mjs && node tests/desktop-glass.mjs",
    "test:packaged": "node tests/run-packaged.mjs"
  },
  "build": {
    "appId": "com.tom.office",
    "productName": "Tom Office",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/icon.png",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "fileAssociations": [{ "ext": "tom", "name": "Tom Office 文档", "description": "Tom Office 可编辑源文件", "role": "Editor", "icon": "assets/icon.ico" }],
    "win": {
      "target": "nsis",
      "signExecutable": false,
      "icon": "assets/icon.ico",
      "artifactName": "Tom-Office-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Tom Office"
    }
  },
  "dependencies": {
    "docx": "^9.1.0",
    "dompurify": "^3.4.18",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "pptxgenjs": "^3.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "pptxgenjs": {
      "image-size": "^2.1.0"
    },
    "@electron/universal": {
      "minimatch": "^11.0.9"
    },
    "app-builder-lib": {
      "minimatch": "^11.0.9"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "concurrently": "^10.0.7",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "vite": "^6.1.0",
    "wait-on": "^9.5.1"
  }
}
